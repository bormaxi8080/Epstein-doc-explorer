{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epstein-explorer:corpus:1",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "scope",
        "archive_uuid",
        "source_sha256",
        "selection_sha256",
        "audit_manifest_sha256",
        "files_count"
      ],
      "properties": {
        "format_version": {
          "const": 1
        },
        "scope": {
          "enum": [
            "pilot",
            "full"
          ]
        },
        "archive_uuid": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audit_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "doc_id",
        "source_sha256",
        "page",
        "method",
        "text",
        "quality",
        "provenance"
      ],
      "properties": {
        "format_version": {
          "const": 1
        },
        "doc_id": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "enum": [
            "native",
            "fcc_ocr",
            "reviewed_no_text"
          ]
        },
        "text": {
          "type": "string"
        },
        "quality": {
          "enum": [
            "accepted",
            "needs_review"
          ]
        },
        "provenance": {
          "type": "object"
        }
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "page_kind",
        "needs_review",
        "blocks"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "page_kind": {
          "enum": [
            "document",
            "table",
            "photo",
            "blank",
            "mixed",
            "unknown"
          ]
        },
        "needs_review": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "kind",
              "bbox"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "paragraph",
                  "table",
                  "header",
                  "footer",
                  "illegible",
                  "redacted"
                ]
              },
              "bbox": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                ]
              }
            }
          }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "doc_id",
        "source_sha256",
        "text_sha256",
        "pages_count",
        "relative_path",
        "page_map"
      ],
      "properties": {
        "format_version": {
          "const": 1
        },
        "doc_id": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pages_count": {
          "type": "integer",
          "minimum": 1
        },
        "relative_path": {
          "type": "string"
        },
        "page_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "start",
              "end",
              "page_sha256"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "page_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "text_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "doc_id",
        "source_sha256",
        "text_sha256",
        "pages_count",
        "relative_path",
        "page_map_ref",
        "offset_unit",
        "review_required"
      ],
      "properties": {
        "format_version": {
          "const": 2
        },
        "doc_id": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pages_count": {
          "type": "integer",
          "minimum": 1
        },
        "relative_path": {
          "type": "string"
        },
        "page_map_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "offset_unit": {
          "const": "unicode_codepoint"
        },
        "review_required": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
