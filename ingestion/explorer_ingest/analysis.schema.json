{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epstein-explorer:analysis:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["one_sentence_summary", "paragraph_summary", "category", "content_tags", "date_range_earliest", "date_range_latest", "rdf_triples"],
  "properties": {
    "one_sentence_summary": {"type": "string", "minLength": 1},
    "paragraph_summary": {"type": "string", "minLength": 1},
    "category": {"enum": ["court_filing", "email", "letter", "memorandum", "report", "transcript", "financial_document", "media_article", "book_excerpt", "photo_caption", "mixed_document", "public record", "other"]},
    "content_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 20},
    "date_range_earliest": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date_range_latest": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "rdf_triples": {
      "type": "array", "maxItems": 300,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["actor", "action", "target", "timestamp", "location", "tags", "explicit_topic", "assertion_type", "evidence"],
        "properties": {
          "actor": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "timestamp": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "location": {"type": ["string", "null"]},
          "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 10},
          "explicit_topic": {"type": "string"},
          "assertion_type": {"enum": ["document_statement", "allegation", "testimony", "denial"]},
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["page", "quote"],
            "properties": {"page": {"type": "integer", "minimum": 1}, "quote": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
